// CCTV platform — Phase 1 schema (SQL Server)
// Prisma on SQL Server has no native enums; string columns with documented values are used instead.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

/// Application user. role: ADMIN | OPERATOR | VIEWER
model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique @db.NVarChar(64)
  passwordHash String   @db.NVarChar(255)
  displayName  String   @db.NVarChar(128)
  role         String   @default("VIEWER") @db.NVarChar(16)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  eventsCreated      Event[]    @relation("EventCreatedBy")
  eventsAcknowledged Event[]    @relation("EventAcknowledgedBy")
  auditLogs          AuditLog[]
  layouts            Layout[]
}

/// A saved video-wall layout: a set of camera tiles with position/size, used in Live and
/// synchronized playback. config is JSON — see apps/web/src/types.ts LayoutConfig.
model Layout {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.NVarChar(128)
  description String?  @db.NVarChar(500)
  config      String   @db.NVarChar(Max)
  isShared    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdById Int?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Floor {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.NVarChar(8)
  name      String   @db.NVarChar(128)
  sortOrder Int      @default(0)
  rooms     Room[]
  cameras   Camera[]
  nvrs      Nvr[]
}

model Room {
  id      Int     @id @default(autoincrement())
  code    String  @db.NVarChar(8)
  name    String  @db.NVarChar(128)
  floorId Int
  floor   Floor   @relation(fields: [floorId], references: [id])
  cameras Camera[]
  nvrs    Nvr[]

  @@unique([floorId, code])
}

/// Network video recorder. brand: HIKVISION | TPLINK | OTHER
model Nvr {
  id             Int       @id @default(autoincrement())
  name           String    @unique @db.NVarChar(128)
  legacyDeviceNo String?   @db.NVarChar(32)
  brand          String    @default("HIKVISION") @db.NVarChar(32)
  model          String?   @db.NVarChar(128)
  serialNo       String?   @db.NVarChar(128)
  host           String    @db.NVarChar(64)
  httpPort       Int       @default(80)
  rtspPort       Int       @default(554)
  username       String?   @db.NVarChar(64)
  /// AES-256-GCM, base64 (see src/lib/crypto.ts)
  passwordEnc    String?   @db.NVarChar(512)
  maxChannels    Int       @default(16)
  /// RTSP path templates for a channel; {ch} is the 1-based channel number
  channelMainPath String   @default("/Streaming/Channels/{ch}01") @db.NVarChar(256)
  channelSubPath  String   @default("/Streaming/Channels/{ch}02") @db.NVarChar(256)
  /// Playback RTSP path template; {ch} channel, {start}/{end} as yyyyMMddTHHmmssZ
  playbackPath   String    @default("/Streaming/tracks/{ch}01?starttime={start}&endtime={end}") @db.NVarChar(256)
  status         String    @default("UNKNOWN") @db.NVarChar(16)
  lastSeenAt     DateTime?
  notes          String?   @db.NVarChar(1000)
  floorId        Int?
  floor          Floor?    @relation(fields: [floorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roomId         Int?
  room           Room?     @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  cameras        Camera[]
}

/// Camera.
/// protocol: HIKVISION (ISAPI/RTSP direct) | ONVIF (go2rtc onvif discovery) | RTSP (explicit paths) | NVR_CHANNEL (plug-and-play via NVR)
/// status: UNKNOWN | ONLINE | OFFLINE
model Camera {
  id             Int       @id @default(autoincrement())
  deviceNo       String    @unique @db.NVarChar(32)
  name           String    @db.NVarChar(128)
  description    String?   @db.NVarChar(500)
  brand          String    @default("UNKNOWN") @db.NVarChar(32)
  model          String?   @db.NVarChar(128)
  protocol       String    @default("ONVIF") @db.NVarChar(16)
  host           String?   @db.NVarChar(64)
  rtspPort       Int       @default(554)
  httpPort       Int       @default(80)
  username       String?   @db.NVarChar(64)
  passwordEnc    String?   @db.NVarChar(512)
  /// Overrides for protocol RTSP (full path incl. leading slash)
  mainStreamPath String?   @db.NVarChar(256)
  subStreamPath  String?   @db.NVarChar(256)
  /// When true the grid sub-stream is a scaled-down H.264 transcode (for cams with no real sub)
  subTranscode   Boolean   @default(false)
  nvrId          Int?
  nvr            Nvr?      @relation(fields: [nvrId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  /// 1-based channel number on the NVR (needed for NVR_CHANNEL and for playback)
  nvrChannel     Int?
  floorId        Int?
  floor          Floor?    @relation(fields: [floorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roomId         Int?
  room           Room?     @relation(fields: [roomId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isEnabled      Boolean   @default(true)
  status         String    @default("UNKNOWN") @db.NVarChar(16)
  lastSeenAt     DateTime?
  sortOrder      Int       @default(0)
  /// Raw values from the legacy registry, kept for traceability
  /// Link to the device registry (MA.DevicesMaster.ID) — the real PK on their side
  registryId     Int?
  owner          String?   @db.NVarChar(128)
  secondaryIp    String?   @db.NVarChar(64)
  registrySyncedAt DateTime?
  legacyId       Int?
  legacyNvrRef   String?   @db.NVarChar(64)
  purchaseDate   DateTime?
  warrantyEnd    DateTime?
  price          Decimal?  @db.Decimal(12, 2)
  /// Free-form flags raised by the importer (e.g. NVR_UNMAPPED, CHANNEL_UNKNOWN)
  importFlags    String?   @db.NVarChar(256)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  /// Fisheye lens calibration for in-browser dewarping: "cx,cy,r,fov" — circle centre and radius as
  /// fractions of the frame width/height (r of the width) and the lens field of view in degrees.
  /// Null = normal lens.
  fisheye        String?   @db.NVarChar(64)

  /// Central recording (Phase 2): when true the recorder process writes this camera to disk
  recordEnabled  Boolean   @default(false)
  /// Which go2rtc stream to record: MAIN | SUB
  recordStream   String    @default("MAIN") @db.NVarChar(8)

  /// Face entry/exit log (Phase 3): when true the face worker (apps/face/worker.py) watches this camera
  faceEnabled    Boolean   @default(false)
  /// IN | OUT | CHECK — IN/OUT: entrance/exit camera; CHECK: only confirms an IN (src/services/in-check.ts)
  faceDirection  String?   @db.NVarChar(8)
  /// Detection zone as fractions of the frame "x0,y0,x1,y1" (0..1); null = whole frame
  faceZone       String?   @db.NVarChar(64)

  groupMembers   CameraGroupMember[]
  events         Event[]
  recordings     Recording[]
  accessEvents   AccessEvent[]

  @@index([registryId])
}

model CameraGroup {
  id          Int                 @id @default(autoincrement())
  name        String              @unique @db.NVarChar(128)
  description String?             @db.NVarChar(500)
  gridColumns Int                 @default(4)
  sortOrder   Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  members     CameraGroupMember[]
}

model CameraGroupMember {
  groupId   Int
  cameraId  Int
  sortOrder Int         @default(0)
  group     CameraGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  camera    Camera      @relation(fields: [cameraId], references: [id], onDelete: Cascade)

  @@id([groupId, cameraId])
}

/// Incident / event record.
/// type: INCIDENT | MAINTENANCE | INTRUSION | ACCESS | OTHER (AI types added later)
/// severity: LOW | MEDIUM | HIGH | CRITICAL
/// source: MANUAL | AI | NVR | SYSTEM
model Event {
  id               Int       @id @default(autoincrement())
  cameraId         Int?
  camera           Camera?   @relation(fields: [cameraId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type             String    @default("INCIDENT") @db.NVarChar(32)
  severity         String    @default("MEDIUM") @db.NVarChar(16)
  source           String    @default("MANUAL") @db.NVarChar(16)
  title            String    @db.NVarChar(200)
  description      String?   @db.NVarChar(2000)
  startedAt        DateTime
  endedAt          DateTime?
  snapshotPath     String?   @db.NVarChar(512)
  clipPath         String?   @db.NVarChar(512)
  /// JSON payload from the detector (zones, labels, scores) — Phase 2
  metadata         String?   @db.NVarChar(Max)
  createdById      Int?
  createdBy        User?     @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  acknowledgedAt   DateTime?
  acknowledgedById Int?
  acknowledgedBy   User?     @relation("EventAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([startedAt])
  @@index([cameraId, startedAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  action    String   @db.NVarChar(64)
  entity    String   @db.NVarChar(64)
  entityId  String?  @db.NVarChar(64)
  detail    String?  @db.NVarChar(Max)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Setting {
  key   String @id @db.NVarChar(64)
  value String @db.NVarChar(Max)
}

/// One recorded file (default 60 s) written by the recorder (src/recorder.ts).
/// filePath is relative to RECORDINGS_DIR. Times are UTC.
model Recording {
  id         Int      @id @default(autoincrement())
  cameraId   Int
  camera     Camera   @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  startedAt  DateTime
  endedAt    DateTime
  durationMs Int
  filePath   String   @unique @db.NVarChar(400)
  sizeBytes  BigInt
  videoCodec String?  @db.NVarChar(16)
  width      Int?
  height     Int?
  hasAudio   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([cameraId, startedAt])
  @@index([startedAt])
}

/// One person passing a face camera (one tracked face), written by the face worker via the API.
/// No face templates are stored here — only the matched code, scores and a snapshot crop
/// (snapshotPath is relative to FACE_DATA_DIR). Times are UTC.
model AccessEvent {
  id           Int      @id @default(autoincrement())
  cameraId     Int
  camera       Camera   @relation(fields: [cameraId], references: [id], onDelete: Cascade)
  /// IN | OUT | CHECK (confirmation-camera sighting, see in-check.ts) — IN | OUT: the camera's direction for people walking towards it, the opposite for people
  /// clearly walking away (see travelY / sizeGrowth)
  direction    String   @db.NVarChar(8)
  /// MATCHED (confident) | UNCERTAIN (best guess, needs review) | UNKNOWN
  status       String   @db.NVarChar(16)
  empCode      String?  @db.NVarChar(32)
  empName      String?  @db.NVarChar(200)
  similarity   Float
  /// top-1 minus top-2 similarity
  margin       Float
  /// JSON [{code,name,sim}] top-3, for review
  candidates   String?  @db.NVarChar(2000)
  firstSeenAt  DateTime
  lastSeenAt   DateTime
  frames       Int
  faceSize     Int
  snapshotPath String?  @db.NVarChar(400)
  /// Movement of the face during the pass: vertical travel as a fraction of the zone height
  /// (+ = down the frame, i.e. towards a ceiling camera) and face-width growth (last/first).
  /// Used to tell a person walking towards the camera from one walking away (direction).
  travelY      Float?
  sizeGrowth   Float?
  /// "SCAN" when an UNCERTAIN match was promoted to MATCHED because the suggested employee scanned a
  /// fingerprint right around the pass (services/scan-confirm.ts); scanGapSec = scan time − pass time.
  confirmedBy  String?  @db.NVarChar(8)
  scanGapSec   Int?
  /// Set when a person corrects the match in the UI
  reviewedById Int?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())

  @@index([firstSeenAt])
  @@index([cameraId, firstSeenAt])
  @@index([empCode, firstSeenAt])
}

/// Fingerprint time-attendance scanner (ZKTeco F18 …), read by apps/attendance/pull.py.
/// READ ONLY: the puller never clears logs, changes users or settings on the device.
model AttendanceDevice {
  id             Int       @id @default(autoincrement())
  /// Name used in ZKTime.Net, e.g. "1-1" = floor 1, scanner 1
  alias          String    @db.NVarChar(32)
  ip             String    @unique @db.NVarChar(64)
  port           Int       @default(4370)
  floor          String?   @db.NVarChar(8)
  enabled        Boolean   @default(true)
  serial         String?   @db.NVarChar(64)
  firmware       String?   @db.NVarChar(64)
  /// logs currently stored on the device
  records        Int?
  /// device clock minus server clock, seconds (scanner clocks drift — matters in disputes)
  clockOffsetSec Int?
  lastPullAt     DateTime?
  lastOkAt       DateTime?
  lastError      String?   @db.NVarChar(500)
  punches        AttendancePunch[]
}

/// One fingerprint/card/password scan as stored on the device.
model AttendancePunch {
  id        Int              @id @default(autoincrement())
  deviceId  Int
  device    AttendanceDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  /// user id on the scanner (≈ employee code; ZKTime.Net USERINFO.Badgenumber)
  userId    String           @db.NVarChar(24)
  /// UTC (the device keeps Bangkok local time; converted by the puller)
  punchAt   DateTime
  /// verify type reported by the device (1 = fingerprint …) and its in/out state key
  status    Int?
  punch     Int?
  createdAt DateTime         @default(now())

  @@unique([deviceId, userId, punchAt])
  @@index([userId, punchAt])
  @@index([punchAt])
}
