# SQL Server connection (Prisma sqlserver provider)
DATABASE_URL="sqlserver://localhost:1433;database=cctv;user=sa;password=ChangeMe_Strong1!;encrypt=true;trustServerCertificate=true"

# 32+ random characters. Used to encrypt device passwords (AES-256-GCM) and to sign JWTs.
APP_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# go2rtc API (server side)
GO2RTC_URL="http://localhost:1984"
# go2rtc URL the browser can reach (returned to the frontend)
GO2RTC_PUBLIC_URL="http://localhost:1984"

PORT=3000
# Comma separated origins allowed by CORS
CORS_ORIGINS="http://localhost:5173"

# First admin account, created automatically when the users table is empty
SEED_ADMIN_USERNAME="admin"
SEED_ADMIN_PASSWORD="admin1234"

# Camera health check interval (seconds); 0 disables
HEALTH_CHECK_INTERVAL=300
