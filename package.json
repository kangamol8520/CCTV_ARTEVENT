{
  "name": "cctv-platform",
  "private": true,
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:api": "bun run --cwd apps/api dev",
    "dev:web": "bun run --cwd apps/web dev",
    "db:generate": "bun run --cwd apps/api db:generate",
    "db:push": "bun run --cwd apps/api db:push",
    "import:registry": "bun run --cwd apps/api import:registry",
    "apply:credentials": "bun run --cwd apps/api apply:credentials",
    "export:registry": "bun run --cwd apps/api export:registry",
    "discover:onvif": "bun run --cwd apps/api discover:onvif",
    "typecheck": "bun run --cwd apps/api typecheck && bun run --cwd apps/web typecheck"
  }
}
